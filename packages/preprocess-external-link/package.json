{
	"name": "@svelte-put/preprocess-external-link",
	"version": "1.0.0",
	"description": "add appropriate attributes to external links",
	"main": "src/lib/index.js",
	"module": "src/lib/index.js",
	"types": "types/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./src/lib/index.js"
		},
		"./preprocessor": {
			"types": "./types/index.d.ts",
			"import": "./src/lib/preprocessor/index.js"
		}
	},
	"typesVersions": {
		"*": {
			"preprocessor": [
				"./types/index.d.ts"
			]
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"types"
	],
	"scripts": {
		"lint": "run-p lint:*",
		"lint:es": "svelte-kit sync && eslint .",
		"lint:style": "stylelint '**/*.{svelte,css}'",
		"format": "prettier --write --ignore-path=../../.prettierignore --config=../../prettier.config.js .",
		"build": "svelte-kit sync && dts-buddy --write && publint",
		"dev": "vite dev"
	},
	"keywords": [
		"svelte",
		"preprocess",
		"href",
		"anchor",
		"external",
		"link",
		"target"
	],
	"author": {
		"email": "oss@vnphanquang.com",
		"name": "Quang Phan",
		"url": "https://github.com/vnphanquang"
	},
	"license": "MIT",
	"homepage": "https://github.com/vnphanquang/svelte-put/tree/main/packages/preprocess-external-link",
	"bugs": {
		"url": "https://github.com/vnphanquang/svelte-put/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vnphanquang/svelte-put.git",
		"directory": "packages/preprocess-external-link"
	},
	"devDependencies": {
		"@types/estree": "^1.0.6"
	},
	"peerDependencies": {
		"svelte": ">=5.0.0",
		"vite": ">=8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"dependencies": {
		"magic-string": "^1.4.2",
		"zimmerframe": "^1.1.5"
	}
}
