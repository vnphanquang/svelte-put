{
	"name": "@svelte-put/avatar",
	"version": "4.0.0",
	"description": "utilities for copying text to clipboard in Svelte land",
	"main": "src/lib/index.js",
	"module": "src/lib/index.js",
	"types": "types/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"svelte": "./src/lib/index.js",
			"import": "./src/lib/index.js"
		},
		"./Avatar.svelte": {
			"types": "./src/lib/Avatar.svelte.d.ts",
			"svelte": "./src/lib/Avatar.svelte"
		}
	},
	"typesVersions": {
		"*": {
			"Avatar.svelte": [
				"./src/lib/Avatar.svelte.d.ts"
			]
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/lib",
		"types"
	],
	"scripts": {
		"lint": "run-p lint:*",
		"lint:es": "svelte-kit sync && eslint .",
		"lint:knip": "pnpm knip --directory ../../ --workspace @svelte-put/avatar",
		"format": "prettier --write --ignore-path=../../.prettierignore --config=../../prettier.config.js .",
		"build": "svelte-kit sync && dts-buddy --write && publint",
		"dev": "vite dev"
	},
	"keywords": [
		"svelte",
		"component",
		"utility",
		"avatar",
		"gravatar",
		"uiavatar"
	],
	"author": {
		"email": "oss@vnphanquang.com",
		"name": "Quang Phan",
		"url": "https://github.com/vnphanquang"
	},
	"license": "MIT",
	"homepage": "https://svelte-put.vnphanquang.com/packages/avatar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vnphanquang/svelte-put.git",
		"directory": "packages/avatar"
	},
	"bugs": {
		"url": "https://github.com/vnphanquang/svelte-put/issues"
	},
	"peerDependencies": {
		"@types/md5": "^2.3.5",
		"svelte": ">=5.0.0"
	},
	"dependencies": {
		"js-sha256": "^1.0.0"
	}
}
