{
	"name": "@svelte-put/qr",
	"version": "2.1.3",
	"description": "render QR as svg or img",
	"main": "src/lib/index.js",
	"module": "src/lib/index.js",
	"types": "types/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/lib/index.js"
		},
		"./img": {
			"types": "./types/index.d.ts",
			"import": "./src/lib/img/index.js"
		},
		"./img/QR.svelte": {
			"types": "./src/lib/img/QR.svelte.d.ts",
			"svelte": "./src/lib/img/QR.svelte"
		},
		"./svg": {
			"types": "./types/index.d.ts",
			"import": "./src/lib/svg/index.js"
		},
		"./svg/QR.svelte": {
			"types": "./src/lib/svg/QR.svelte.d.ts",
			"svelte": "./src/lib/svg/QR.svelte"
		}
	},
	"typesVersions": {
		"*": {
			"img": [
				"./types/index.d.ts"
			],
			"img/QR.svelte": [
				"./src/img/QR.svelte.d.ts"
			],
			"svg": [
				"./types/index.d.ts"
			],
			"svg/QR.svelte": [
				"./src/svg/QR.svelte.d.ts"
			]
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/lib",
		"types"
	],
	"scripts": {
		"lint": "run-p lint:*",
		"lint:es": "svelte-kit sync && eslint .",
		"lint:knip": "pnpm knip --directory ../../ --workspace @svelte-put/qr",
		"format": "prettier --write --ignore-path=../../.prettierignore --config=../../prettier.config.js .",
		"build": "svelte-kit sync && dts-buddy --write && publint",
		"dev": "vite dev"
	},
	"keywords": [
		"svelte",
		"action",
		"component",
		"qr",
		"img",
		"base64",
		"svg",
		"logo"
	],
	"author": {
		"email": "vnphanquang@gmail.com",
		"name": "Quang Phan",
		"url": "https://github.com/vnphanquang"
	},
	"license": "MIT",
	"homepage": "https://svelte-put.vnphanquang.com/packages/qr",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vnphanquang/svelte-put.git",
		"directory": "packages/qr"
	},
	"bugs": {
		"url": "https://github.com/vnphanquang/svelte-put/issues"
	},
	"peerDependencies": {
		"svelte": ">=5.0.0"
	},
	"dependencies": {
		"headless-qr": "^1.0.3"
	}
}
