{
	"name": "@svelte-put/async-stack",
	"version": "1.5.3",
	"description": "build type-safe and async component stack",
	"main": "src/lib/index.js",
	"module": "src/lib/index.js",
	"types": "types/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/lib/index.js"
		},
		"./helpers": {
			"types": "./types/index.d.ts",
			"import": "./src/lib/helpers/index.js"
		}
	},
	"typesVersions": {
		"*": {
			"helpers": [
				"./types/index.d.ts"
			]
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/lib",
		"types"
	],
	"scripts": {
		"sync": "svelte-kit sync",
		"lint": "run-p lint:*",
		"lint:es": "svelte-kit sync && eslint .",
		"lint:knip": "pnpm knip --directory ../../ --workspace @svelte-put/async-stack",
		"format": "prettier --write --ignore-path=../../.prettierignore --config=../../prettier.config.js .",
		"build": "svelte-kit sync && dts-buddy --write && publint",
		"dev": "vite dev"
	},
	"keywords": [
		"svelte",
		"action",
		"notification",
		"modal",
		"stack",
		"push",
		"pop",
		"toast",
		"async",
		"push",
		"typescript",
		"type-safe",
		"headless",
		"builder",
		"portal"
	],
	"author": {
		"email": "oss@vnphanquang.com",
		"name": "Quang Phan",
		"url": "https://github.com/vnphanquang"
	},
	"license": "MIT",
	"homepage": "https://vnphanquang.com/projects/svelte-put/packages/async-stack",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vnphanquang/svelte-put.git",
		"directory": "packages/async-stack"
	},
	"bugs": {
		"url": "https://github.com/vnphanquang/svelte-put/issues"
	},
	"peerDependencies": {
		"svelte": ">=5.0.0"
	},
	"dependencies": {
		"defu": "^6.1.7"
	}
}
