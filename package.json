{
	"name": "svelte-put",
	"private": true,
	"license": "MIT",
	"author": {
		"email": "oss@vnphanquang.com",
		"name": "Quang Phan",
		"url": "https://github.com/vnphanquang"
	},
	"type": "module",
	"scripts": {
		"boot": "pnpm install && run-p boot:*",
		"boot:lefthook": "lefthook install",
		"boot:packages": "pnpm --filter=\"./packages/**\" build",
		"boot:env": "pnpm --filter=\"./sites/**\" boot:env",
		"lint": "pnpm -r lint",
		"format": "prettier --write .",
		"test": "vitest --coverage",
		"ci:test": "vitest run --coverage"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@internals/docpage": "workspace:*",
		"@svelte-put/toc": "workspace:*",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-devtools-svelte": "^0.11.0",
		"@types/node": "24.19.0",
		"@vitejs/devtools": "^0.8.3",
		"@vitejs/devtools-vite": "^0.8.3",
		"@vitest/coverage-v8": "^5.1.1",
		"@vitest/ui": "^5.1.1",
		"@vnphanquang/eslint-config": "^5.0.1",
		"@vnphanquang/gach": "^2.0.1",
		"@vnphanquang/markdown": "^2.0.0",
		"dts-buddy": "^0.8.3",
		"eslint": "10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"knip": "^6.47.0",
		"my-bad": "^1.2.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.10.1",
		"prettier-plugin-embed": "^0.8.2",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"stylelint": "^18.1.0",
		"stylelint-config-clean-order": "^10.0.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-standard": "^41.1.0",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.19.0",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.8.1",
			"onFail": "download"
		}
	}
}
