{
	"name": "@svelte-put/toc",
	"version": "7.0.0-next.0",
	"description": "Strategies for building Table of Contents in Svelte land",
	"main": "src/lib/index.js",
	"module": "src/lib/index.js",
	"types": "types/index.d.ts",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./src/lib/index.js"
		},
		"./preprocessor": {
			"types": "./types/index.d.ts",
			"import": "./src/lib/preprocessor/index.js"
		},
		"./vite": {
			"types": "./types/index.d.ts",
			"import": "./src/lib/vite/index.js"
		},
		"./styles.css": "./src/lib/styles/index.css",
		"./styles/*.css": "./src/lib/styles/*.css"
	},
	"typesVersions": {
		"*": {
			"preprocessor": [
				"./types/index.d.ts"
			],
			"vite": [
				"./types/index.d.ts"
			]
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/lib",
		"types"
	],
	"scripts": {
		"lint": "run-p lint:*",
		"lint:es": "svelte-kit sync && eslint .",
		"lint:style": "stylelint '**/*.{svelte,css}'",
		"lint:knip": "pnpm knip --directory ../../ --workspace @svelte-put/toc",
		"format": "prettier --write --ignore-path=../../.prettierignore --config=../../prettier.config.js .",
		"build": "svelte-kit sync && dts-buddy --write && publint",
		"dev": "vite dev"
	},
	"keywords": [
		"svelte",
		"action",
		"tableofcontents",
		"toc",
		"@svelte-put",
		"svelte-put",
		"table-of-contents",
		"table of contents",
		"table",
		"content",
		"utility",
		"store",
		"intersection observer",
		"intersection",
		"observer",
		"anchor"
	],
	"author": {
		"email": "oss@vnphanquang.com",
		"name": "Quang Phan",
		"url": "https://github.com/vnphanquang"
	},
	"license": "MIT",
	"homepage": "https://github.com/vnphanquang/svelte-put/tree/main/packages/toc",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vnphanquang/svelte-put.git",
		"directory": "packages/toc"
	},
	"bugs": {
		"url": "https://github.com/vnphanquang/svelte-put/issues"
	},
	"devDependencies": {
		"@types/estree": "^1.0.9",
		"svelte": "^5.57.2"
	},
	"dependencies": {
		"github-slugger": "^2.0.0",
		"magic-string": "^1.4.3",
		"zimmerframe": "^1.1.5"
	},
	"peerDependencies": {
		"svelte": ">=5.0.0",
		"vite": ">=8.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	}
}
