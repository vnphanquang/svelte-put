{
	"name": "@svelte-put/inline-svg",
	"version": "5.0.0-next.0",
	"description": "Strategies to inline SVGs in Svelte land",
	"main": "src/lib/index.js",
	"module": "src/lib/index.js",
	"types": "types/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./src/lib/index.js"
		},
		"./preprocessor": {
			"types": "./types/index.d.ts",
			"import": "./src/lib/preprocessor/index.js"
		},
		"./vite": {
			"types": "./types/index.d.ts",
			"import": "./src/lib/vite/index.js"
		}
	},
	"typesVersions": {
		"*": {
			"preprocessor": [
				"./types/index.d.ts"
			],
			"vite": [
				"./types/index.d.ts"
			]
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/lib",
		"types"
	],
	"scripts": {
		"lint": "run-p lint:*",
		"lint:es": "svelte-kit sync && eslint .",
		"lint:style": "stylelint '**/*.{svelte,css}'",
		"lint:knip": "pnpm knip --directory ../../ --workspace @svelte-put/inline-svg",
		"format": "prettier --write --ignore-path=../../.prettierignore --config=../../prettier.config.js .",
		"build": "svelte-kit sync && dts-buddy --write && publint",
		"dev": "vite dev"
	},
	"keywords": [
		"svelte",
		"action",
		"svg",
		"inline",
		"dynamic",
		"static",
		"build",
		"runtime",
		"vite",
		"preprocessor",
		"static",
		"compiletime"
	],
	"author": {
		"email": "oss@vnphanquang.com",
		"name": "Quang Phan",
		"url": "https://github.com/vnphanquang"
	},
	"license": "MIT",
	"homepage": "https://svelte-put.vnphanquang.com/packages/inline-svg",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vnphanquang/svelte-put.git",
		"directory": "packages/inline-svg"
	},
	"bugs": {
		"url": "https://github.com/vnphanquang/svelte-put/issues"
	},
	"devDependencies": {
		"@types/lodash.debounce": "^4.0.9",
		"@types/svg-parser": "^2.0.6",
		"svelte": "^5.57.2"
	},
	"dependencies": {
		"hast-util-to-html": "^9.0.5",
		"lodash.debounce": "^4.0.8",
		"magic-string": "^1.4.3",
		"svg-parser": "^2.1.0",
		"zimmerframe": "^1.1.5"
	},
	"peerDependencies": {
		"svelte": ">=5.0.0",
		"vite": ">=8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
