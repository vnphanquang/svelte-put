{
	"name": "svelte-put",
	"private": true,
	"workspaces": [
		"internals/*",
		"configs/*",
		"packages/*"
	],
	"license": "MIT",
	"author": {
		"email": "vnphanquang@gmail.com",
		"name": "Quang Phan",
		"url": "https://github.com/vnphanquang"
	},
	"type": "module",
	"scripts": {
		"boot": "pnpm install && run-p boot:*",
		"boot:lefthook": "lefthook install",
		"boot:packages": "pnpm --filter=\"./packages/**\" build",
		"boot:env": "pnpm --filter=\"./sites/**\" boot:env",
		"lint": "pnpm -r lint",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"@vnphanquang/eslint-config": "link:../vnphanquang/packages/eslint-config",
		"dts-buddy": "^0.8.3",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.9.8",
		"prettier-plugin-embed": "^0.5.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.24",
		"shx": "^0.4.0",
		"stylelint": "^17.15.0",
		"stylelint-config-clean-order": "^10.0.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.16.0",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.6.0",
			"onFail": "download"
		}
	}
}
