{
	"name": "docs",
	"version": "v2",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": [
			"./src/lib/*",
			"./src/lib/*.js",
			"./src/lib/*/index.js",
			"./src/lib/*.ts",
			"./src/lib/*/index.ts"
		],
		"#data/*": [
			"./src/data/*",
			"./src/data/*.js",
			"./src/data/*/index.js",
			"./src/data/*.ts",
			"./src/data/*/index.ts"
		]
	},
	"scripts": {
		"boot:env": "shx cp .env.example .env",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "run-p lint:*",
		"lint:es": "svelte-kit sync && eslint .",
		"lint:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint:style": "stylelint '**/*.{svelte,css}'",
		"format": "prettier --write --ignore-path=../../.prettierignore --config=../../prettier.config.js ."
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "8.0.0-next.7",
		"@types/umami-browser": "^2.18.1"
	}
}
