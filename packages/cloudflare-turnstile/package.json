{
	"name": "@svelte-put/cloudflare-turnstile",
	"version": "1.2.0",
	"description": "utilities for setting up Cloudflare turnstile in Svelte land",
	"main": "src/lib/index.js",
	"module": "src/lib/index.js",
	"types": "types/index.d.ts",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/lib/index.js"
		},
		"./server": {
			"types": "./types/index.d.ts",
			"default": "./src/lib/server/index.js"
		},
		"./tailwind.css": "./src/lib/tailwind.css"
	},
	"typesVersions": {
		"*": {
			"server": [
				"./types/index.d.ts"
			]
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/lib",
		"types"
	],
	"scripts": {
		"lint": "run-p lint:*",
		"lint:es": "svelte-kit sync && eslint .",
		"lint:knip": "pnpm knip --directory ../../ --workspace @svelte-put/cloudflare-turnstile",
		"format": "prettier --write --ignore-path=../../.prettierignore --config=../../prettier.config.js .",
		"build": "svelte-kit sync && dts-buddy --write && publint",
		"dev": "vite dev"
	},
	"keywords": [
		"svelte",
		"action",
		"turnstile",
		"cloudflare",
		"captcha"
	],
	"author": {
		"email": "oss@vnphanquang.com",
		"name": "Quang Phan",
		"url": "https://github.com/vnphanquang"
	},
	"license": "MIT",
	"homepage": "https://svelte-put.vnphanquang.com/packages/cloudflare-turnstile",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vnphanquang/svelte-put.git",
		"directory": "packages/cloudflare-turnstile"
	},
	"bugs": {
		"url": "https://github.com/vnphanquang/svelte-put/issues"
	},
	"peerDependencies": {
		"svelte": ">=5.0.0"
	}
}
