		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "24.19.0",
		"@vnphanquang/eslint-config": "link:../vnphanquang/packages/eslint-config",
		"@vnphanquang/gach": "link:../vnphanquang/packages/gach",
		"@vnphanquang/markdown": "link:../vnphanquang/packages/markdown",
		"dts-buddy": "^0.8.3",
		"eslint": "10.10.0",
		"eslint-plugin-svelte": "^3.23.0",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.0.2",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.9.8",
		"prettier-plugin-embed": "^0.5.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.24",
		"shx": "^0.4.0",
		"stylelint": "^17.15.0",
		"stylelint-config-clean-order": "^10.0.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"valibot": "^1.5.0",
		"vite": "^8.3.2",
		"vite-plugin-qrcode": "^0.4.1"
